# API_KEY: client bearer token (create via `make api-key` or /console/api-keys).
# API_KEY=texet_...
# DATABASE_URL: SQLAlchemy async URL for the app database (match .env.db creds).
DATABASE_URL=postgresql+asyncpg://texet:change_me@db:5432/texet
# DATABASE_URL_TEST: SQLAlchemy async URL for tests.
DATABASE_URL_TEST=postgresql+asyncpg://texet:change_me@db:5432/texet_test
# SMS_OUTBOUND_URL: webhook endpoint for outbound replies.
SMS_OUTBOUND_URL=https://sms.example.com/webhook
# SMS_OUTBOUND_AUTHORIZATION: Authorization header value for outbound SMS (e.g., "Bearer <token>").
SMS_OUTBOUND_AUTHORIZATION=Bearer change_me
# SMS_TIMEOUT_SECONDS: outbound HTTP timeout in seconds.
SMS_TIMEOUT_SECONDS=15
# MODERATION_ALERT_EMAILS: comma-separated emails for moderation alert forwarding.
MODERATION_ALERT_EMAILS=moderator1@example.com,moderator2@example.com
# MAIL_USERNAME: SMTP username for moderation alert email.
MAIL_USERNAME=change_me
# MAIL_PASSWORD: SMTP password/app password for moderation alert email.
MAIL_PASSWORD=change_me
# MAIL_FROM: sender email for moderation alert email.
MAIL_FROM=noreply@example.com
# MAIL_SERVER: SMTP host for moderation alert email.
MAIL_SERVER=smtp.example.com
# MAIL_PORT: SMTP port for moderation alert email.
MAIL_PORT=465
# MAIL_SSL_TLS: SMTP SSL/TLS toggle.
MAIL_SSL_TLS=true
# MAIL_STARTTLS: SMTP STARTTLS toggle.
MAIL_STARTTLS=false
# MAIL_USE_CREDENTIALS: whether to authenticate to SMTP.
MAIL_USE_CREDENTIALS=true
# MAIL_VALIDATE_CERTS: whether to validate SMTP certs.
MAIL_VALIDATE_CERTS=true
# OPENAI_API_KEY: API key for OpenAI.
OPENAI_API_KEY=change_me
# OPENAI_MODEL: OpenAI model name (e.g., gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
# AWS_ACCESS_KEY_ID: AWS access key for Bedrock (optional; falls back to IAM instance profile).
AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY: AWS secret access key for Bedrock (optional; falls back to IAM instance profile).
AWS_SECRET_ACCESS_KEY=
# AWS_REGION: AWS region for Bedrock (default: us-east-1).
AWS_REGION=us-east-1
# ADMIN_USERNAME: SQLAdmin login username.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD: SQLAdmin login password.
ADMIN_PASSWORD=change_me
# ADMIN_SECRET_KEY: admin session secret (use a long random value).
ADMIN_SECRET_KEY=change_me
# ADMIN_SESSION_TTL_SECONDS: admin session TTL in seconds.
ADMIN_SESSION_TTL_SECONDS=28800
