# API_TOKEN: bearer token for /chat.
API_TOKEN=change_me
# SMS_OUTBOUND_URL: webhook endpoint for outbound replies.
SMS_OUTBOUND_URL=https://sms.example.com/webhook
# SMS_TIMEOUT_SECONDS: outbound HTTP timeout in seconds.
SMS_TIMEOUT_SECONDS=15
# OPENAI_API_KEY: API key for OpenAI.
OPENAI_API_KEY=change_me
# OPENAI_MODEL: OpenAI model name (e.g., gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
# ADMIN_USERNAME: SQLAdmin login username.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD: SQLAdmin login password.
ADMIN_PASSWORD=change_me
# ADMIN_SECRET_KEY: admin session secret (use a long random value).
ADMIN_SECRET_KEY=change_me
# ADMIN_SESSION_TTL_SECONDS: admin session TTL in seconds.
ADMIN_SESSION_TTL_SECONDS=28800
# ADMIN_EXPORT_MAX_ROWS: max rows per admin export.
ADMIN_EXPORT_MAX_ROWS=10000
