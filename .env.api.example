# ── Database ───────────────────────────────────────────────────────────────
# Match credentials in .env.db. Use db:5432 inside Docker, localhost:5432 locally.
DATABASE_URL=postgresql+asyncpg://texet:change_me@db:5432/texet
# Used by pytest only.
DATABASE_URL_TEST=postgresql+asyncpg://texet:change_me@db:5432/texet_test

# ── SMS delivery ───────────────────────────────────────────────────────────
# Webhook that receives outbound replies. Leave blank to skip SMS (replies will be marked failed).
SMS_OUTBOUND_URL=https://sms.example.com/webhook
# Full Authorization header value sent to the webhook (e.g. "Bearer <token>").
SMS_OUTBOUND_AUTHORIZATION=Bearer change_me
SMS_TIMEOUT_SECONDS=15

# ── Moderation email alerts ────────────────────────────────────────────────
# Comma-separated recipient addresses. Leave blank to disable email alerts.
MODERATION_ALERT_EMAILS=moderator1@example.com,moderator2@example.com
# Base URL of the app (no trailing slash). Used for admin links in alert emails.
PUBLIC_APP_URL=https://texet.example.com
MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_FROM=noreply@example.com
MAIL_USERNAME=change_me
MAIL_PASSWORD=change_me
MAIL_SSL_TLS=true
MAIL_STARTTLS=false
MAIL_USE_CREDENTIALS=true
MAIL_VALIDATE_CERTS=true

# ── LLM ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=change_me
OPENAI_MODEL=gpt-4o-mini
# Bedrock credentials (optional — leave blank to use the IAM instance profile).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Admin console ──────────────────────────────────────────────────────────
# Console is disabled if any of the three required fields below are blank.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
# Use a long random string (e.g. openssl rand -hex 32).
ADMIN_SECRET_KEY=change_me
ADMIN_SESSION_TTL_SECONDS=28800
