# Elastic Beanstalk (bot-prod) runs a single container, so the reply worker
# must run alongside the web server in that same container. RUN_WORKER_INLINE
# makes scripts/docker-entrypoint.sh launch `python -m app.worker` next to
# uvicorn. ECS and local compose run a separate worker service instead and
# leave this unset.
#
# Capacity tuning for ~100 rps (500 users): the worker needs enough concurrent
# slots to complete replies at that rate (slots ~= target_rps x reply_latency),
# and the DB pool must cover those slots. bot-prod autoscales 1->6 x t3.large
# on request count, and the DB (texet-chatbot-db, db.m5.large) has ample
# connection headroom for instances x (pool + overflow). MAX_QUEUE_DEPTH still
# sheds load with 503 if demand outruns capacity.
option_settings:
  aws:elasticbeanstalk:application:environment:
    RUN_WORKER_INLINE: "true"
    WORKER_CONCURRENCY: "80"
    DB_POOL_SIZE: "20"
    DB_MAX_OVERFLOW: "40"
